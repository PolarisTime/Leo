# 环境变量示例（复制为 .env 或写进 systemd Environment=）
# 全部由部署环境注入，代码里不硬编码任何凭据。

# ---- 进程 ----
# 监听端口：与 leo 后端 11211、前端 3100 并列
PORT=11212
# 裸机可绑 127.0.0.1 交给 nginx；容器内用 0.0.0.0
COLLAB_HOST=127.0.0.1
# WebSocket 路径（前缀），nginx 的 location 必须与之匹配
COLLAB_WS_PATH=/collab
COLLAB_HEALTH_PATH=/healthz

# ---- 数据库 ----
# 缺省是本地 dev 库；生产必须显式配置，且账号只需这几张表的读写权限：
#   mk_supplier_price_collab_doc / mk_supplier_price_collab_update / mk_supplier_price_cell_op
#   mk_supplier_price_item / mk_supplier_price_list
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/leo
# 启动时校验表结构：strict（默认，缺表即失败）/ warn（本地无 V218 时只告警）
COLLAB_SCHEMA_CHECK=strict

# ---- 鉴权 ----
# 必须与 Java 侧签发协作票据使用同一个 HS256 密钥，至少 16 个字符
COLLAB_JWT_SECRET=please-change-me-at-least-16-chars

# ---- Redis（可选，多实例扇出）----
# 不配置 = 单实例模式；配置后启用 @hocuspocus/extension-redis 并发布 collab:list-changed
# REDIS_URL=redis://127.0.0.1:6379/0

# ---- 同步与持久化 ----
# onStoreDocument 的 debounce（毫秒），设计文档要求 500
COLLAB_DEBOUNCE_MS=500
COLLAB_MAX_DEBOUNCE_MS=2000
# 单条 Yjs update 上限（字节），超过直接拒绝
COLLAB_MAX_UPDATE_BYTES=262144
# 每用户最大并发连接数
COLLAB_MAX_CONNECTIONS_PER_USER=5
# 首次连接时从 SQL 价格表生成初始 Y.Doc（阶段 0 影子同步的前提）
COLLAB_BOOTSTRAP_FROM_SQL=1
# 是否把增量 update 追加进 mk_supplier_price_collab_update
COLLAB_PERSIST_UPDATES=1

# ---- 物化 ----
COLLAB_MATERIALIZE_RETRY_BASE_MS=500
COLLAB_MATERIALIZE_RETRY_MAX_MS=60000
# 雪花机器号：必须与 Java 的 leo.id.machine-id 错开，否则同一毫秒同序列会撞主键
COLLAB_SNOWFLAKE_WORKER_ID=7

# ---- 存储与日志 ----
# postgres（默认）/ memory（本地无库调试，数据不落库）
COLLAB_STORE=postgres
# debug | info | warn | error
COLLAB_LOG_LEVEL=info
# 优雅退出的最长等待
COLLAB_SHUTDOWN_TIMEOUT_MS=15000
