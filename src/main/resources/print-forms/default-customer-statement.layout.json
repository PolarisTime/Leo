        "width": 46,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center",
        "normalize": "compactAscii"
      },
      {
        "key": "spec",
        "label": "规格型号",
        "width": 36,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "length",
