      "left": 460,
      "top": 90,
      "width": 107,
      "height": 18,
      "fontSize": 10.5,
      "color": "#1f1f1f"
    }
  },
  "table": {
    "source": "items",
    "left": 28,
    "top": 116,
    "continuationTop": 24,
    "bottom": 640,
    "width": 539,
    "headerHeight": 22,
    "rowHeight": 22,
    "maxRowsPerPage": 60,
    "repeatHeaderPerSourceGroup": false,
    "repeatHeaderPerPage": true,
    "repeatGroupContextOnContinuation": false,
    "sourceGroupGap": 0,
    "fillPage": true,
    "headerFillColor": "#f5f7fa",
    "borderColor": "#d9d9d9",
    "headerTextColor": "#1f1f1f",
    "textColor": "#1f1f1f",
    "emptyFillColor": "#fafafa",
    "emptyTextColor": "#8c8c8c",
    "emptyText": "暂无对账明细",
    "lineWidth": 0.5,
    "grouping": {
      "by": "sourceNo",
      "inline": true,
      "indexField": "groupIndex",
      "blankRepeatedFields": [
        "groupIndex",
        "billTime",
        "remark"
      ],
      "continuationFillFields": [
        "groupIndex",
        "billTime",
        "remark"
      ],
      "sortBy": "billTime",
      "sortDirection": "asc"
    },
    "mergeColumns": [
      "groupIndex",
      "billTime",
      "remark"
    ],
    "mergeEqualColumns": [],
    "columns": [
      {
        "key": "groupIndex",
        "label": "序号",
        "width": 26,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "billTime",
        "label": "进货日期",
        "width": 66,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center",
        "format": "chineseDate"
      },
      {
        "key": "category",
