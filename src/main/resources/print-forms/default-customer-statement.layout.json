        "width": 38,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "quantity",
        "label": "件数",
        "width": 28,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "weightTon",
        "label": "重量小计/吨",
        "width": 54,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "unitPrice",
        "label": "单价",
        "width": 40,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "amount",
        "label": "金额",
        "width": 56,
        "headerFontSize": 7,
        "fontSize": 7.5,
        "align": "center"
      },
      {
        "key": "remark",
