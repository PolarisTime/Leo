      "top": 90,
      "width": 176,
      "height": 18,
      "fontSize": 11,
      "color": "#1f1f1f"
    }
  },
  "table": {
    "source": "items",
    "left": 28,
    "top": 118,
    "continuationTop": 28,
    "bottom": 462,
    "width": 786,
    "headerHeight": 24,
    "rowHeight": 24,
    "repeatHeaderPerSourceGroup": false,
    "repeatHeaderPerPage": true,
    "repeatGroupContextOnContinuation": false,
    "sourceGroupGap": 0,
    "headerFillColor": "#f5f7fa",
    "borderColor": "#d9d9d9",
    "headerTextColor": "#1f1f1f",
    "textColor": "#1f1f1f",
    "emptyFillColor": "#fafafa",
    "emptyTextColor": "#8c8c8c",
    "emptyText": "暂无对账明细",
    "lineWidth": 1,
    "grouping": {
      "by": "billTime",
      "inline": true,
      "indexField": "groupIndex",
      "blankRepeatedFields": [
        "groupIndex",
        "billTime"
      ],
      "sortBy": "billTime",
      "sortDirection": "asc",
      "continuationFillFields": [
        "groupIndex",
        "billTime"
      ]
    },
    "columns": [
      {
        "key": "groupIndex",
        "label": "序号",
        "width": 40,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "center"
      },
      {
        "key": "billTime",
        "label": "进货日期",
        "width": 72,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "center",
        "format": "chineseDate"
      },
      {
        "key": "category",
        "label": "产品名称",
        "width": 66,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "brand",
        "label": "产地",
        "width": 62,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "material",
        "label": "牌号商标",
        "width": 74,
        "headerFontSize": 8,
        "fontSize": 8,
        "normalize": "compactAscii"
      },
      {
        "key": "spec",
        "label": "规格型号",
        "width": 56,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "length",
        "label": "长度",
        "width": 38,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "pieceWeightTon",
        "label": "件重/吨",
        "width": 56,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "quantity",
        "label": "件数",
        "width": 40,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "weightTon",
        "label": "重量小计/吨",
        "width": 70,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "unitPrice",
        "label": "单价(元/吨)",
        "width": 64,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "amount",
        "label": "总金额/元",
        "width": 80,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "remark",
        "label": "备注",
        "width": 68,
        "headerFontSize": 8,
        "fontSize": 8
      }
    ],
    "maxRowsPerPage": 60,
    "fillPage": true
  },
  "summary": {
    "height": 34,
    "template": "合计件数：${totalQuantity} 件    合计重量：${totalWeight} 吨    销售金额：${salesAmount} 元    已收金额：${receiptAmount} 元    期末余额：${closingAmount} 元",
    "fontSize": 9,
    "align": "right",
    "border": true,
    "fillColor": "#e6f4ff",
    "borderColor": "#d9d9d9",
    "textColor": "#1677ff",
    "lineWidth": 1,
    "defaults": {
      "receiptAmount": "0.00",
      "salesAmount": "0.00",
      "closingAmount": "0.00"
    }
  },
  "clauses": {
    "height": 66,
    "fontSize": 9,
    "lineHeight": 1.35,
    "textColor": "#595959",
    "lines": [
      "1. 请在收到本对账单后按约定期限核对并反馈，逾期未反馈的，视为对账数据已确认。",
      "2. 本对账单仅用于双方往来核对，最终结算以合同、发票、收付款凭证及双方确认资料为准。",
      "3. 如对账数据存在差异，请提供对应单据编号、金额及差异说明以便复核。"
    ]
  }
}
