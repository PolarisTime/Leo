  "summary": {
    "height": 22,
    "align": "center",
    "border": true,
    "borderColor": "#d9d9d9",
    "textColor": "#1f1f1f",
    "lineWidth": 0.5,
    "alignToColumns": true,
    "defaults": {
      "receiptAmount": "0.00",
      "salesAmount": "0.00",
      "closingAmount": "0.00",
      "totalWeight": "0.000"
    },
    "cells": {
      "category": "合计",
      "quantity": "${totalQuantity}",
      "weightTon": "${totalWeight}",
      "amount": "${salesAmount}"
    },
    "grid": {
      "rowHeight": 22,
      "fontSize": 8,
      "color": "#1f1f1f",
      "borderColor": "#d9d9d9",
      "columnWidths": [
        96,
        70,
        96,
        70,
        96,
        70,
        41
      ],
      "rows": [
        [
          "累计数量合计",
          "${totalWeight}",
          "按合同应付金额",
          "",
          "累计已开票金额",
          "",
          ""
        ],
        [
          "累计应收金额",
          "${salesAmount}",
          "累计已收金额",
          "${receiptAmount}",
          "累计欠款金额",
          "${closingAmount}",
          ""
        ]
      ]
    }
  },
  "clauses": {
    "height": 104,
    "fontSize": 8.5,
