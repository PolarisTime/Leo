      "maxLines": 2,
      "lineHeight": 1.2,
      "multiline": true,
      "vertical": "top",
      "color": "#1f1f1f"
    },
    "customerName": {
      "source": [
        "customerName",
        "counterpartyName"
      ],
      "left": 100,
      "top": 90,
      "width": 420,
      "height": 18,
      "fontSize": 11,
      "color": "#1f1f1f"
    },
    "endDate": {
      "source": [
        "endDate",
        "statementDate"
      ],
      "format": "chineseDate",
      "left": 610,
      "top": 90,
      "width": 176,
      "height": 18,
      "fontSize": 11,
      "color": "#1f1f1f"
    }
  },
  "table": {
    "source": "items",
    "left": 28,
    "top": 118,
    "continuationTop": 28,
    "bottom": 462,
    "width": 786,
    "headerHeight": 24,
    "rowHeight": 24,
    "repeatHeaderPerSourceGroup": false,
    "repeatHeaderPerPage": true,
    "repeatGroupContextOnContinuation": false,
    "sourceGroupGap": 0,
    "headerFillColor": "#f5f7fa",
    "borderColor": "#d9d9d9",
    "headerTextColor": "#1f1f1f",
    "textColor": "#1f1f1f",
    "emptyFillColor": "#fafafa",
    "emptyTextColor": "#8c8c8c",
    "emptyText": "暂无对账明细",
    "lineWidth": 1,
    "grouping": {
      "by": "billTime",
      "inline": true,
      "indexField": "groupIndex",
      "blankRepeatedFields": [
        "groupIndex",
        "billTime"
      ],
      "sortBy": "billTime",
      "sortDirection": "asc",
      "continuationFillFields": [
        "groupIndex",
        "billTime"
      ]
    },
    "columns": [
      {
        "key": "groupIndex",
        "label": "序号",
        "width": 40,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "center"
      },
      {
        "key": "billTime",
        "label": "进货日期",
        "width": 72,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "center",
        "format": "chineseDate"
      },
      {
        "key": "category",
        "label": "产品名称",
        "width": 66,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "brand",
        "label": "产地",
        "width": 62,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "material",
        "label": "牌号商标",
        "width": 74,
        "headerFontSize": 8,
        "fontSize": 8,
        "normalize": "compactAscii"
      },
      {
        "key": "spec",
        "label": "规格型号",
        "width": 56,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "length",
        "label": "长度",
        "width": 38,
        "headerFontSize": 8,
        "fontSize": 8
      },
      {
        "key": "pieceWeightTon",
        "label": "件重/吨",
        "width": 56,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "quantity",
        "label": "件数",
        "width": 40,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "weightTon",
        "label": "重量小计/吨",
        "width": 70,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "unitPrice",
        "label": "单价(元/吨)",
        "width": 64,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "amount",
        "label": "总金额/元",
        "width": 80,
        "headerFontSize": 8,
        "fontSize": 8,
        "align": "right"
      },
      {
        "key": "remark",
        "label": "备注",
        "width": 68,
        "headerFontSize": 8,
        "fontSize": 8
      }
    ],
    "maxRowsPerPage": 60,
    "fillPage": true,
    "mergeColumns": [
      "groupIndex",
      "billTime"
    ]
  },
  "summary": {
    "height": 30,
    "fontSize": 9,
    "align": "center",
    "border": true,
    "borderColor": "#d9d9d9",
    "textColor": "#1f1f1f",
    "lineWidth": 1,
    "defaults": {
      "receiptAmount": "0.00",
      "salesAmount": "0.00",
      "closingAmount": "0.00",
      "totalWeight": "0.000"
    },
    "grid": {
      "rowHeight": 24,
      "fontSize": 9,
      "color": "#1f1f1f",
      "borderColor": "#d9d9d9",
      "columnWidths": [
        120,
        100,
        140,
        100,
        130,
        100,
        96
      ],
      "rows": [
        [
          "累计数量合计",
          "${totalWeight}",
          "按合同应付金额",
          "",
          "累计已开票金额",
          "",
          ""
        ],
        [
          "累计应收金额",
          "${salesAmount}",
          "累计已收金额",
          "${receiptAmount}",
          "累计欠款金额",
          "${closingAmount}",
          ""
        ]
      ]
    },
    "alignToColumns": true,
    "cells": {
      "category": "合计",
      "quantity": "${totalQuantity}",
      "weightTon": "${totalWeight}",
      "amount": "${salesAmount}"
    }
  },
  "clauses": {
    "height": 92,
    "fontSize": 9,
    "lineHeight": 1.55,
    "paddingTop": 8,
    "textColor": "#1f1f1f",
    "lines": [
      "备注：单价按我的钢铁网杭州地区到货当天上午价+20，",
      "本对账单经双方核对无误，予以确认",
      "供方盖章：                                需方盖章（或合同受权人）签字：",
      "经办人签字："
    ]
  }
}
